# Prose evidence units hold full extracted text, so they stay local whatever
# the licence — the manifests' `prose` block already carries the structure.
projects/**/units/

# Large remote-pulled obs table (92.8GB source h5ad; reproducible via h5ad_obs/pull_obs.py).
# Full obs is 151MB (>GitHub limit); commit the compact obs.categoricals.parquet instead.
projects/**/h5ad_obs/obs.parquet

# Office lock/temp files and session scratch
~$*
*.tmp

# Non-shareable source PDFs
projects/**/inputs/do_not_share/

# --- Local snippet index -------------------------------------------------
# THIS REPO IS PUBLIC. chunks/, snippet_index/ and citations/sentences.jsonl
# hold verbatim paper text, so they may only be committed for sources whose
# licence permits redistribution. manifest.json, citations/ref_resolution.json
# and corpus.json are bibliographic metadata only (no paper text) and are
# committed for every paper.
#
# Never commit source documents here — originals live in inputs/.
projects/**/local_index/papers/*/source/

# Verbatim text: excluded by default (covers all non-open sources).
projects/**/local_index/papers/*/chunks/
projects/**/local_index/papers/*/snippet_index/
projects/**/local_index/papers/*/citations/sentences.jsonl

# Re-included: the atlas preprint 10.64898/2026.06.10.731198 is bioRxiv CC-BY
# (`license: cc_by`), so its derived text is redistributable with attribution
# (attribution travels in manifest.json / snippets[].paper).
!projects/**/local_index/papers/10.64898_*/chunks/
!projects/**/local_index/papers/10.64898_*/snippet_index/
!projects/**/local_index/papers/10.64898_*/citations/sentences.jsonl
!projects/**/local_index/papers/10.64898_*/source/
!projects/**/local_index/papers/10.64898_*/source/paper.jats.xml
projects/**/local_index/papers/10.64898_*/source/*.pdf
