__pycache__/
*.egg-info/
.python-version
.DS_Store
.env
.venv
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
dist/
build/
docs/_build/
.claude/settings.local.json

# Test projects: commit setup only (cas.json, README); ignore generated outputs
projects/test_projects/**/traversal_output/
projects/test_projects/**/reports/
projects/test_projects/**/selections/
projects/test_projects/**/runs/
projects/test_projects/**/routing/

# Supplement store: retrieved/manually-dropped files and unpacked archives are
# never committed; the manifests describing them are.
projects/**/supplements/**/files/
projects/**/supplements/incoming/*
!projects/**/supplements/incoming/README.md

# THIS REPO IS PUBLIC, and the rule above only covers `files/`. The store also
# holds fetched article source and extracted supplement text — verbatim, and
# mostly from publishers whose licence does not permit redistribution. So
# everything in the store is ignored by default, and re-included by exception.
projects/**/supplements/**

# A manifest is a finding aid, not the paper: filenames, media types, sizes,
# checksums, the publisher's own captions, and section headings with character
# offsets. It carries no article body text, so it travels whatever the paper's
# licence says — and without it nobody can tell what the corpus even contains.
!projects/**/supplements/
!projects/**/supplements/papers/
!projects/**/supplements/papers/*/
!projects/**/supplements/papers/*/manifest.json

# Article XML and extracted text ARE the paper. Re-included only where the
# manifest records `license.redistributable: true` (CC-BY-4.0 or CC0). The
# slugs are written out because .gitignore cannot read a manifest; re-derive
# them from the manifests rather than editing this list by hand.
!projects/**/supplements/papers/10.1002_ctm2.1219/source/
!projects/**/supplements/papers/10.1002_ctm2.1219/source/paper.jats.xml
!projects/**/supplements/papers/10.1002_ctm2.1219/text/
!projects/**/supplements/papers/10.1002_ctm2.1219/text/*.txt
!projects/**/supplements/papers/10.1038_s41467-020-14936-3/source/
!projects/**/supplements/papers/10.1038_s41467-020-14936-3/source/paper.jats.xml
!projects/**/supplements/papers/10.1038_s41467-020-14936-3/text/
!projects/**/supplements/papers/10.1038_s41467-020-14936-3/text/*.txt
!projects/**/supplements/papers/10.1038_s41467-020-20358-y/source/
!projects/**/supplements/papers/10.1038_s41467-020-20358-y/source/paper.jats.xml
!projects/**/supplements/papers/10.1038_s41467-020-20358-y/text/
!projects/**/supplements/papers/10.1038_s41467-020-20358-y/text/*.txt
!projects/**/supplements/papers/10.1038_s41586-022-04918-4/source/
!projects/**/supplements/papers/10.1038_s41586-022-04918-4/source/paper.jats.xml
!projects/**/supplements/papers/10.1038_s41586-022-04918-4/text/
!projects/**/supplements/papers/10.1038_s41586-022-04918-4/text/*.txt
